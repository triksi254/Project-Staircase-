# ============================================================
# University Web Scraper - Environment Configuration
# Copy to .env and adjust as needed
# ============================================================

# --- Logging ---
LOG_LEVEL=INFO
# LOG_FILE=logs/scraper.log

# --- Database ---
# SQLite (default)
DATABASE_URL=sqlite:///./university_data.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/university_scraper

# --- Behavior ---
USE_PLAYWRIGHT=True
VALIDATE_DATA=True
INTEGRATE_FAQ=True

# --- Scraper defaults ---
DEFAULT_DELAY=1.5
DEFAULT_MAX_PAGES=10
DEFAULT_TIMEOUT=30
WAIT_SELECTOR_TIMEOUT=15000
MAX_RETRIES=3
RETRY_BACKOFF=2.0

# --- FAQ ---
FAQ_RELEVANCE_THRESHOLD=0.10

# --- Request identity ---
USER_AGENT=UniversityScraper/1.0 (+https://github.com/example/university-scraper; educational research)

