# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
build/
dist/
develop-eggs/

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Scraped data outputs (generated by the scraper pipeline)
data/raw/
data/processed/

# Local SQLite database generated by tests/smoke_test.py
*.db

# Raw assessment-form emails - contain PII and are deliberately kept OUT of
# the repo (they live beside it, e.g. <repo>/../CounsellorForms/Forms).
# Never commit these. The cleaned, PII-redacted exports under
# CounsellorForms/output/ ARE tracked on purpose (the research corpus).
CounsellorForms/Forms/

# One-off exploration scripts and dumped page text
scratch/

# Lead-scoring model artifacts (leads/train_ml.py). The trained binary is
# regenerable, but the metrics/importance JSON files are kept as dissertation
# appendix artifacts.
artifacts/*.pkl

# Generated ML / retrieval caches (rebuilt by tests; keep repo lean).
data/tfidf_vectorizer.pkl
data/tfidf_matrix.npy
data/faq_corpus.bak.json
models/classifier.pkl
models/lead_model.pkl

# Sentence-BERT embedding cache (chatbot/embeddings.py). Keyed by corpus
# fingerprint + model name, rebuilt on first use; the model weights live in
# the HuggingFace cache outside the repo.
data/embeddings_*.npy
data/embeddings_*.json

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Streamlit local config/secrets (dashboard/app.py) — never commit.
.streamlit/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
